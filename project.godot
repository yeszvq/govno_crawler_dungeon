; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Последний костёр"
config/description="Кооперативный данжен-кроулер на 4 игроков по локальной сети."
run/main_scene="res://main/main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Events="*res://autoload/events.gd"
Net="*res://autoload/net.gd"
LanDiscovery="*res://autoload/lan_discovery.gd"
GameClock="*res://autoload/game_clock.gd"
Grid="*res://autoload/grid.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/gdUnit4/plugin.cfg")

